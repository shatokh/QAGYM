generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  ru

  @@map("locale")
}

enum PublicationState {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publication_state")
}

enum CreatorRole {
  WRITER
  ARTIST

  @@map("creator_role")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum OrderStatus {
  PLACED
  CANCELLED

  @@map("order_status")
}

model Comic {
  id                  Int                @id @default(autoincrement())
  slug                String             @unique(map: "comics_slug_key") @db.VarChar(120)
  sku                 String             @unique(map: "comics_sku_key") @db.VarChar(64)
  seriesId            Int?               @map("series_id")
  issueNumber         Int?               @map("issue_number")
  priceMinor          Int                @map("price_minor")
  compareAtPriceMinor Int?               @map("compare_at_price_minor")
  currencyCode        String             @map("currency_code") @db.Char(3)
  stockQuantity       Int                @map("stock_quantity")
  publicationState    PublicationState   @default(DRAFT) @map("publication_state")
  coverPath           String?            @map("cover_path") @db.VarChar(255)
  sortOrder           Int                @default(0) @map("sort_order")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  series              Series?            @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  translations        ComicTranslation[]
  creators            ComicCreator[]
  genres              ComicGenre[]
  cartLines           CartLine[]
  orderLines          OrderLine[]

  @@unique([seriesId, issueNumber], map: "comics_series_id_issue_number_key")
  @@index([publicationState, sortOrder, id], map: "comics_publication_state_sort_order_id_idx")
  @@map("comics")
}

model ComicTranslation {
  comicId     Int    @map("comic_id")
  locale      Locale
  title       String @db.VarChar(200)
  description String @db.Text
  comic       Comic  @relation(fields: [comicId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([comicId, locale], map: "comic_translations_pkey")
  @@map("comic_translations")
}

model Series {
  id           Int                 @id @default(autoincrement())
  slug         String              @unique(map: "series_slug_key") @db.VarChar(120)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  comics       Comic[]
  translations SeriesTranslation[]

  @@map("series")
}

model SeriesTranslation {
  seriesId Int    @map("series_id")
  locale   Locale
  title    String @db.VarChar(160)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([seriesId, locale], map: "series_translations_pkey")
  @@map("series_translations")
}

model Creator {
  id          Int            @id @default(autoincrement())
  slug        String         @unique(map: "creators_slug_key") @db.VarChar(120)
  displayName String         @map("display_name") @db.VarChar(160)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  comics      ComicCreator[]

  @@map("creators")
}

model ComicCreator {
  comicId   Int         @map("comic_id")
  creatorId Int         @map("creator_id")
  role      CreatorRole
  sortOrder Int         @default(0) @map("sort_order")
  comic     Comic       @relation(fields: [comicId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creator   Creator     @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([comicId, creatorId, role], map: "comic_creators_pkey")
  @@index([creatorId], map: "comic_creators_creator_id_idx")
  @@map("comic_creators")
}

model Genre {
  id           Int                @id @default(autoincrement())
  slug         String             @unique(map: "genres_slug_key") @db.VarChar(80)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  comics       ComicGenre[]
  translations GenreTranslation[]

  @@map("genres")
}

model GenreTranslation {
  genreId Int    @map("genre_id")
  locale  Locale
  name    String @db.VarChar(80)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([genreId, locale], map: "genre_translations_pkey")
  @@map("genre_translations")
}

model ComicGenre {
  comicId Int   @map("comic_id")
  genreId Int   @map("genre_id")
  comic   Comic @relation(fields: [comicId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([comicId, genreId], map: "comic_genres_pkey")
  @@index([genreId], map: "comic_genres_genre_id_idx")
  @@map("comic_genres")
}

model User {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique(map: "users_public_id_key") @map("public_id") @db.VarChar(80)
  email        String    @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(160)
  role         UserRole  @default(USER)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  cart         Cart?
  orders       Order[]

  @@map("users")
}

model Session {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique(map: "carts_user_id_key") @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lines     CartLine[]

  @@map("carts")
}

model CartLine {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  comicId   Int      @map("comic_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comic     Comic    @relation(fields: [comicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cartId, comicId], map: "cart_lines_cart_id_comic_id_key")
  @@index([comicId], map: "cart_lines_comic_id_idx")
  @@map("cart_lines")
}

model Order {
  id               Int         @id @default(autoincrement())
  orderNumber      String      @unique(map: "orders_order_number_key") @map("order_number") @db.VarChar(18)
  userId           Int         @map("user_id")
  status           OrderStatus @default(PLACED)
  recipientName    String      @map("recipient_name") @db.VarChar(120)
  addressLine1     String      @map("address_line1") @db.VarChar(160)
  addressLine2     String?     @map("address_line2") @db.VarChar(160)
  city             String      @db.VarChar(120)
  region           String?     @db.VarChar(120)
  postalCode       String      @map("postal_code") @db.VarChar(32)
  countryCode      String      @map("country_code") @db.Char(2)
  totalItems       Int         @map("total_items")
  totalAmountMinor Int         @map("total_amount_minor")
  currencyCode     String      @map("currency_code") @db.Char(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines            OrderLine[]

  @@index([userId, createdAt, id], map: "orders_user_id_created_at_id_idx")
  @@map("orders")
}

model OrderLine {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  comicId        Int?     @map("comic_id")
  comicSlug      String   @map("comic_slug") @db.VarChar(120)
  sku            String   @db.VarChar(64)
  title          String   @db.VarChar(200)
  contentLocale  Locale   @map("content_locale")
  quantity       Int
  unitPriceMinor Int      @map("unit_price_minor")
  lineTotalMinor Int      @map("line_total_minor")
  currencyCode   String   @map("currency_code") @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comic          Comic?   @relation(fields: [comicId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId], map: "order_lines_order_id_idx")
  @@index([comicId], map: "order_lines_comic_id_idx")
  @@map("order_lines")
}
